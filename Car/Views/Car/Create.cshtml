@model Car.Models.Car.CreateCarViewModel
<div class ="container">
    <div class="col">
        <h2>Add a new Car!</h2>
    </div>
    <form method="post" enctype="multipart/form-data">
        <div class="form-group">
            <label asp-for="NumberPlate">Number Plate</label>
            <input asp-for="NumberPlate" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="Model"></label>
            <input asp-for="Model" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="Make"></label>
            <input asp-for="Make" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="Year"></label>
            <input asp-for="Year" type="number" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="Color"></label>
            <input asp-for="Color" class="form-control" />
        </div>

        <input asp-action="create" asp-controller="Car" type="submit" class="button" value="Add" />
    </form>

    <a asp-action="index" asp-controller="Car">Back</a>
</div>
