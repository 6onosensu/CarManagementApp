@model Car.Models.Car.DeleteCarViewModel

<div class="container">
    <div class="row align-content-center">
        <div class="col">
            <h2>Are you sure you want to delete the car @Model.NumberPlate?</h2>
            <p>If you proceed, all service records associated with this car will also be permanently deleted.</p>
        </div>
        <div class="col text-end">
            <form asp-action="DeleteConfirmation">
                <input type="hidden" asp-for="Id" />
                <input type="submit" value="Delete" class="btn btn-danger" />
            </form>
            <a asp-action="Details" asp-controller="Car" asp-route-id="@Model.Id" class="btn btn-light">Cancel</a>
        </div>
    </div>
    <hr />
    <div class="row align-content-center">
        <div>
            <div>
                <div class="col-md-4"><strong>Model:</strong> @Model.Model</div>
                <div class="col-md-4"><strong>Make:</strong> @Model.Make</div>
                <div class="col-md-4"><strong>Year:</strong> @Model.Year</div>
                <div class="col-md-4"><strong>Color:</strong> @Model.Color</div>
                <div class="col-md-4"><strong>Created At:</strong> @Model.CreatedAt</div>
                <div class="col-md-4"><strong>Modified At:</strong> @Model.ModifiedAt</div>
            </div>
        </div>
    </div>
    <hr />

    <div class="row align-items-center">
        <div class="col">
            <h3>All Records</h3>
        </div>
    </div>
    <hr />

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Pass</th>
                <th>Created</th>
                <th>Modified</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var record in Model.ServiceRecords)
            {
                <tr>
                    <td>@record.Title</td>
                    <td>@record.Description</td>
                    <td>@(record.IsPass ? "Yes" : "No")</td>
                    <td>@record.CreatedAt</td>
                    <td>@record.ModifiedAt</td>
                </tr>
            }
        </tbody>
    </table>
</div>