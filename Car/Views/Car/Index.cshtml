@model IEnumerable<Car.Models.Car.CarsIndexViewModel>

@{
    int rowNumber = 1;
}

<div class="row">
    <div class="h1">Cars</div>
    <div>
        <a asp-action="create" asp-controller="Car" type="submit">Create</a>
    </div>
</div>
<hr />

<form method="post">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Nr</th>
                <th>Number Plate</th>
                <th>Make</th>
                <th>Model</th>
                <th>Year</th>
                <th>Color</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var car in Model)
            {
                <tr>
                    <td>@rowNumber</td>
                    <td>@car.NumberPlate</td>
                    <td>@car.Make</td>
                    <td>@car.Model</td>
                    <td>@car.Year</td>
                    <td>@car.Color</td>
                    <td>
                        <a asp-action="Details" asp-controller="Car" asp-route-id="@car.Id" class="btn btn-primary">Details</a>
                    </td>
                </tr>
                rowNumber++;
            }
        </tbody>
    </table>
</form>