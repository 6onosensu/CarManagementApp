@model Car.Models.Car.UpdateCarViewModel

<div class="container">
    <div class="row align-content-center">
        <div class="col">
            <h2>Car @Model.NumberPlate</h2>
        </div>
        <div class="col text-end">
            <a asp-action="details" asp-controller="Car" asp-route-id="@Model.Id">Back</a>

        </div>
    </div>
    <hr />
    <div class="row align-content-center">
        <div>
            <div>
                <div class="col-md-4"><strong>Model:</strong> @Model.Model</div>
                <div class="col-md-4"><strong>Make:</strong> @Model.Make</div>
                <div class="col-md-4"><strong>Year:</strong> @Model.Year</div>
                <div class="col-md-4"><strong>Color:</strong> @Model.Color</div>
                <div class="col-md-4"><strong>Created At:</strong> @Model.CreatedAt</div>
                <div class="col-md-4"><strong>Modified At:</strong> @Model.ModifiedAt</div>
            </div>
        </div>

        <form method="post" enctype="multipart/form-data">
            <input asp-for="Id" type="hidden" />

            <div class="form-group">
                <label asp-for="NumberPlate"></label>
                <input asp-for="NumberPlate" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Model"></label>
                <input asp-for="Model" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Make"></label>
                <input asp-for="Make" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Year"></label>
                <input asp-for="Year" type="number" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Color"></label>
                <input asp-for="Color" class="form-control" />
            </div>

            <input asp-for="CreatedAt" type="hidden" />
            <input asp-for="ModifiedAt" type="hidden" />

            <input asp-action="update" asp-controller="Car" type="submit" class="button" value="Update" />
        </form>
    </div>
</div>
