@model Car.Models.CarWithRecordsViewModel
@using Car.Models.ServiceRecord

<div class="container">
    <div class="row align-content-center">
        <div class="col">
            <h2>Car @Model.NumberPlate</h2>
        </div>
        <div class="col text-end">
            <a asp-action="update" asp-controller="Car" asp-route-id="@Model.Id">Update</a> |
            <a asp-action="delete" asp-controller="Car" asp-route-id="@Model.Id">Delete Car with all records</a>
        </div>
    </div>
    <hr />
    <div class="row align-content-center">
        <div>
            <div>
                <div class="col-md-4"><strong>Model:</strong> @Model.Model</div>
                <div class="col-md-4"><strong>Make:</strong> @Model.Make</div>
                <div class="col-md-4"><strong>Year:</strong> @Model.Year</div>
                <div class="col-md-4"><strong>Color:</strong> @Model.Color</div>
                <div class="col-md-4"><strong>Created At:</strong> @Model.CreatedAt</div>
                <div class="col-md-4"><strong>Modified At:</strong> @Model.ModifiedAt</div>
            </div>
        </div>
    </div>
    <hr />

    <div class="row align-items-center">
        <div class="col">
            <h3>All Records</h3>
        </div>
        <div class="col text-end">
            <button class="btn btn-success" id="addRecord">Add Record</button>
        </div>
    </div>
    <hr />
    <div id="recordsTable">
        @Html.Partial("~/Views/Record/_RecordsTable.cshtml", Model.ServiceRecords)
    </div>

    <div id="addRecordContainer" class="mt-3" style="display:none;"> 
        @Html.Partial("~/Views/Record/_AddRecordForm.cshtml", new RecordViewModel { CarId = Model.Id })
    </div>

    <div id="updateRecordContainer" class="mt-3" style="display:none;"></div>
</div>
