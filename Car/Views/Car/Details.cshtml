@model Car.Models.CarWithRecordsViewModel

<div class="container">
    <div class="row align-content-center">
        <div class="col">
            <h2>Car @Model.NumberPlate</h2>
        </div>
        <div class="col text-end">
            <button class="btn btn-success" id="UpdateCarButton">Update</button>
        </div>
    </div>
    <hr />
    <div class="row align-content-center">
        <div>
            <div>
                <div class="col-md-4"><strong>Model:</strong> @Model.Model</div>
                <div class="col-md-4"><strong>Make:</strong> @Model.Make</div>
                <div class="col-md-4"><strong>Year:</strong> @Model.Year</div>
                <div class="col-md-4"><strong>Color:</strong> @Model.Color</div>
                <div class="col-md-4"><strong>Created At:</strong> @Model.CreatedAt</div>
                <div class="col-md-4"><strong>Modified At:</strong> @Model.ModifiedAt</div>
            </div>
        </div>

        <div id="updateCarForm" class="mt-3" style="display:none;">
            <form method="post">
                <div>
                    <div class="col-md-4">
                        <strong>Model:</strong> 
                        <input type="text" value="@Model.Model"/>
                    </div>
                    <div class="col-md-4">
                        <strong>Make:</strong> 
                        <input type="text" value="@Model.Make" />
                    </div>
                    <div class="col-md-4">
                        <strong>Year:</strong> 
                        <input type="number" value="@Model.Year" />
                    </div>
                    <div class="col-md-4">
                        <strong>Color:</strong> 
                        <input type="text" value="@Model.Color" />
                    </div>
                </div>

                <div class="col text-end">
                    <a asp-action="Update" asp-controller="Car" asp-route-id="@Model.Id" class="btn btn-primary">Update</a>
                </div>
            </form>
        </div>
    </div>
    <hr />

    <div class="row align-items-center">
        <div class="col">
            <h3>All Records</h3>
        </div>
        <div class="col text-end">
            <button class="btn btn-success" id="addRecordButton">Add Record</button>
        </div>
    </div>
    <div id="addRecordForm" class="mt-3" style="display:none;">
        <form asp-action="AddRecordToCar" method="post">
            <input type="hidden" name="CarId" value="@Model.Id" />
            <div class="form-group">
                <label for="Title">Title</label>
                <input type="text" name="Title" class="form-control" required />
            </div>
            <div class="form-group">
                <label for="Description">Description</label>
                <textarea name="Description" class="form-control"></textarea>
            </div>
            <div class="form-group">
                <label for="IsPass">Pass</label>
                <input type="checkbox" name="IsPass" />
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>
    <hr />

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Pass</th>
                <th>Created</th>
                <th>Modified</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var record in Model.ServiceRecords)
            {
                <tr>
                    <td>@record.Title</td>
                    <td>@record.Description</td>
                    <td>@(record.IsPass ? "Yes" : "No")</td>
                    <td>@record.CreatedAt</td>
                    <td>@record.ModifiedAt</td>
                    <td>
                        <button class="btn btn-warning btn-sm updateRecordButton" data-id="@record.Id">Update</button>
                        <form asp-action="DeleteRecord" method="post" class="d-inline">
                            <input type="hidden" name="Id" value="@record.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div id="updateRecordForm" class="mt-3" style="display:none;">
        <form asp-action="UpdateRecord" method="post">
            <input type="hidden" id="updateRecordId" name="Id" />
            <div class="form-group">
                <label for="UpdateTitle">Title</label>
                <input type="text" id="updateTitle" name="Title" class="form-control" required />
            </div>
            <div class="form-group">
                <label for="UpdateDescription">Description</label>
                <textarea id="updateDescription" name="Description" class="form-control" required></textarea>
            </div>
            <div class="form-group">
                <label for="UpdateIsPass">Pass</label>
                <input type="checkbox" id="updateIsPass" name="IsPass" />
            </div>
            <button type="submit" class="btn btn-primary">Update</button>
        </form>
    </div>
</div>

<script>
    document.getElementById('UpdateCarButton').addEventListener('click', function () {
        const form = document.getElementById('updateCarForm');
        form.style.display = form.style.display === 'none' ? 'block' : 'none';
    });

    document.getElementById('addRecordButton').addEventListener('click', function() {
        const form = document.getElementById('addRecordForm');
        form.style.display = form.style.display === 'none' ? 'block' : 'none';
    });

    document.querySelectorAll('.updateRecordButton').forEach(button => {
        button.addEventListener('click', function() {
            const recordId = this.getAttribute('data-id');
            const form = document.getElementById('updateRecordForm');
            form.style.display = 'block';

            const row = this.closest('tr');
            document.getElementById('updateRecordId').value = recordId;
            document.getElementById('updateTitle').value = row.cells[0].textContent.trim();
            document.getElementById('updateDescription').value = row.cells[1].textContent.trim();
            document.getElementById('updateIsPass').checked = row.cells[2].textContent.trim() === 'Yes';
        });
    });
</script>
