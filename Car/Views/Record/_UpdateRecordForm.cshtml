@model Car.Models.ServiceRecord.RecordViewModel

<form asp-action="UpdateRecord" asp-controller="Records" method="post" id="updateRecordForm">
    <input type="hidden" asp-for="Id" value="@Model.Id" />
    <input type="hidden" asp-for="CarId" value="@Model.CarId" />
    <div class="form-group">
        <label asp-for="Title"></label>
        <input type="text" asp-for="Title" class="form-control" required />
    </div>
    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control" required></textarea>
    </div>
    <div class="form-group">
        <label asp-for="IsPass">Pass</label>
        <input type="checkbox" asp-for="IsPass" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>
