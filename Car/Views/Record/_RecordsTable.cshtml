@model List<Car.Models.ServiceRecord.RecordsViewModel>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Pass</th>
            <th>Created</th>
            <th>Modified</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var record in Model)
        {
            <tr>
                <td>@record.Title</td>
                <td>@record.Description</td>
                <td>@(record.IsPass ? "Yes" : "No")</td>
                <td>@record.CreatedAt.ToString("g")</td>
                <td>@record.ModifiedAt.ToString("g")</td>
                <td>
                    <button class="btn btn-warning btn-sm updateRecordButton"
                            data-record-id="@record.Id" 
                            data-title="@record.Title" 
                            data-description="@record.Description"
                            data-car-id="@record.CarId">
                        Update
                    </button>
                    <form asp-action="DeleteRecord" asp-controller="Records" method="post" class="d-inline" onsubmit="return confirmDelete();">
                        <input type="hidden" name="Id" value="@record.Id" />
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    function confirmDelete() {
        return confirm("Are you sure you want to delete this record? This action cannot be undone.");
    }
</script>